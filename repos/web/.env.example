# URL pública de la API Go.
NEXT_PUBLIC_API_URL=http://localhost:8080

# URL que se codifica en los QR de las mesas. En desarrollo móvil usá la IP LAN
# del equipo (por ejemplo, http://192.168.1.20:3000), nunca localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth Client ID de tipo "Aplicación web" para Google Identity Services.
# Este identificador es público; nunca agregues el Client Secret al frontend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=000000000000-ejemplo.apps.googleusercontent.com

# Entorno de despliegue ("qa" muestra el banner superior de ambiente de pruebas).
NEXT_PUBLIC_APP_ENV=development
