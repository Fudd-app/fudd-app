# Copiar este archivo como .env y completar los valores locales.
# NUNCA commitear el .env real — solo este .env.example

# Base de datos PostgreSQL
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/mesa_click?sslmode=disable

# Puerto donde corre el servidor Go
PORT=8080

# URL pública o local del frontend (usada para construir los enlaces de login en los emails)
APP_URL=http://localhost:3000

# Clave secreta para firmar los JWT
JWT_SECRET=tu_clave_secreta_jwt_muy_segura

# OAuth Client ID de tipo "Aplicación web" para validar Sign in with Google.
# No usar ni exponer el Client Secret: este flujo valida ID tokens.
GOOGLE_CLIENT_ID=000000000000-ejemplo.apps.googleusercontent.com

# Entorno: development | production
APP_ENV=development
# Orígenes web adicionales separados por coma. APP_URL siempre está permitido.
# CORS_ALLOWED_ORIGINS=https://qa.mesaclick.com,https://admin.mesaclick.com

# ----------------------------------------------------
# Sin BREVO_API_KEY, SMTP_HOST ni RESEND_API_KEY los emails NO se envían: solo se escriben
# en el log. Las invitaciones de equipo siempre devuelven el enlace al dueño/encargado
# autenticado y marcan email_enviado=false para permitir compartirlo manualmente.
# ----------------------------------------------------

# ----------------------------------------------------
# Brevo (recomendado: API HTTP para emails transaccionales)
# Tiene prioridad sobre SMTP y Resend cuando BREVO_API_KEY está configurada.
# El email debe estar validado como remitente en Brevo.
# ----------------------------------------------------
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
# BREVO_SENDER_NAME=fudd
# BREVO_FROM_EMAIL=no-reply@mesaclick.com

# ----------------------------------------------------
# Configuración SMTP (para envío de emails reales)
# Compatible con Gmail, Outlook, Brevo, SendGrid, Mailtrap, etc.
# ----------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion_o_api_key
SMTP_FROM=no-reply@mesaclick.com

# ----------------------------------------------------
# Alternativa: Resend (si se usa API HTTP en vez de SMTP)
# ----------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxx
# FROM_EMAIL=onboarding@resend.dev

# ----------------------------------------------------
# Mercado Pago (Checkout Pro Sandbox / Producción)
# ----------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx-xxxxxx-xxxxxx-xxxxxxxxx
MERCADOPAGO_SANDBOX=true

